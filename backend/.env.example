# ===== 生成引擎（至少配置一家；都不配则无法创建生成任务）=====
# 火山引擎方舟（豆包 Seedance）：https://console.volcengine.com/ark
VOLCENGINE_API_KEY=
# Seedance 模型ID，可在方舟控制台「开通管理」中查看
VOLCENGINE_T2V_MODEL=doubao-seedance-1-0-pro-250528
VOLCENGINE_I2V_MODEL=doubao-seedance-1-0-lite-t2v-250428

# 智谱开放平台（CogVideoX）：https://open.bigmodel.cn
ZHIPU_API_KEY=
ZHIPU_T2V_MODEL=cogvideox-3
ZHIPU_I2V_MODEL=cogvideox-3

# ===== 文生图（与视频引擎共用对应厂商的 API Key，模型ID可换）=====
# 火山 Seedream / 智谱 CogView；复用 VOLCENGINE_API_KEY / ZHIPU_API_KEY
VOLCENGINE_IMAGE_MODEL=doubao-seedream-4-0-250828
ZHIPU_IMAGE_MODEL=cogview-4-250304

# ===== 提示词智能优化（OpenAI 兼容接口，方舟/智谱均可）=====
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-1-6-flash-250415

# ===== 服务配置 =====
SECRET_KEY=change-me-to-a-random-string
# 配额开关：false 时视频/文生图均不限次（自用场景；多人共用建议开启）
QUOTA_ENABLED=true
# 注册开关：给别人用时建议随时可关；第一个注册的用户自动成为管理员
ALLOW_REGISTRATION=true

# 并行生成的任务数上限
MAX_CONCURRENT_TASKS=3
# 文生图独立并行上限与每日配额（不占用视频任务配额）
MAX_CONCURRENT_IMAGE_TASKS=2
IMAGE_DAILY_QUOTA=20

# 新用户每日生成任务配额（管理员可针对单个用户调整）
DEFAULT_DAILY_QUOTA=10
